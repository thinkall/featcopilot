# Per-case scratch files and logs; keep run-level benchmark evidence visible.
benchmarks/tabular-results/*/*/
# Hidden pytest scratch runs are not published benchmark evidence.
benchmarks/tabular-results/.*/
# Archive raw fold evidence as results.json.gz for version control.
benchmarks/tabular-results/*/results.json
# Operational cell checkpoints remain local; result archives retain the evidence.
benchmarks/tabular-results/*/state.json
